DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_leads

REDIS_URL=redis://localhost:6379/0

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

DALLAS_CAD_URL=https://www.dallascad.org/dataproducts.aspx
COLLIN_CAD_API=https://data.texas.gov/resource/7ugx-vxwc.json

ETL_SCHEDULE_CRON=0 2 * * 0
COMP_CACHE_DAYS=90

MIN_EQUITY_THRESHOLD=50000
HIGH_EQUITY_THRESHOLD=100000
MIN_MOTIVATION_SCORE=50

# Comma-separated list of valid API keys required via the X-API-Key header.
# Generate strong random keys for real environments, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=changeme-local-dev-key

# Comma-separated list of allowed CORS origins (no wildcard in production).
ALLOWED_ORIGINS=http://localhost:3000

# Requests allowed per API key (or per IP if no key) per minute.
RATE_LIMIT_PER_MINUTE=60
